# Copiare in .env solo in locale. In produzione usare il secret manager dell'host.
SHOPIFY_API_KEY=replace_with_dev_dashboard_client_id
SHOPIFY_API_SECRET=replace_with_dev_dashboard_client_secret
SHOPIFY_APP_URL=https://replace-me.example.com
SCOPES=read_orders,read_products,read_locations
DATABASE_URL=postgresql://rapportino:local_only_password@localhost:5432/rapportino?schema=public
# Lista ESATTA dei domini autorizzati; obbligatoria per questa distribuzione privata.
ALLOWED_SHOPS=replace-me.myshopify.com
# Nomi esatti (case-insensitive) dei gateway contanti del tuo store, da verificare con POS.
CASH_GATEWAYS=cash,contanti
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
# Gestore che riceve la stampa definitiva; se vuoto si usa EMAIL_TO.
EMAIL_GESTORE=
