{
  "name": "rapportino-giornaliero",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "shopify app dev",
    "dev:web": "remix vite:dev",
    "build": "remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "config:link": "shopify app config link",
    "config:use": "shopify app config use",
    "config:check": "node scripts/check-config.mjs",
    "env:check": "tsx scripts/check-env.ts",
    "deploy": "npm run release:check && shopify app deploy",
    "shopify": "shopify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run db:generate && npm run config:check && npm run typecheck && npm test && npm run build",
    "test:db": "tsx scripts/test-db.ts",
    "preview:report": "tsx scripts/preview-report.tsx",
    "release:check": "node scripts/check-config.mjs --production && npm run env:check && npm run check && npm audit --omit=dev --audit-level=moderate",
    "test:http": "tsx scripts/test-http.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "@remix-run/node": "2.17.5",
    "@remix-run/react": "2.17.5",
    "@remix-run/serve": "2.17.5",
    "@shopify/app-bridge-react": "^4.2.0",
    "@shopify/polaris": "^13.9.5",
    "@shopify/shopify-api": "^15.0.0",
    "@shopify/shopify-app-remix": "6.0.0",
    "@shopify/shopify-app-session-storage": "^7.0.0",
    "@shopify/shopify-app-session-storage-prisma": "11.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.0.0",
    "exceljs": "^4.4.0",
    "isbot": "^5.1.0",
    "luxon": "^3.7.0",
    "nodemailer": "^10.0.11",
    "pdfkit": "^0.17.0",
    "pg": "^8.16.0",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@remix-run/dev": "2.17.5",
    "@shopify/cli": "4.8.2",
    "@types/luxon": "^3.7.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "tar": "^7.5.21",
    "uuid": "^11.1.1",
    "deepmerge-ts": "^8.0.0",
    "toml": "^4.2.0",
    "estree-util-value-to-estree": "^3.3.3",
    "esbuild": "^0.25.0",
    "vite": "^6.4.3",
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6"
  }
}
