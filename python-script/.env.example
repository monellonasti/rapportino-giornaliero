SHOPIFY_SHOP=tuo-store.myshopify.com
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-07
# Facoltativo: se lo lasci vuoto, il nome viene letto automaticamente da Shopify.
# SHOP_NAME=Bottega Demo

# Stampa definitiva: il file viene inviato al gestore con questi dati.
SMTP_HOST=
SMTP_PORT=587
# true per la porta 465 (SSL), false per la 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_GESTORE=
